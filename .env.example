# Local development only. Keep DATABASE_URL in sync with POSTGRES_*.
POSTGRES_PASSWORD=spectron
POSTGRES_PORT=5442
DATABASE_URL=postgresql://spectron:spectron@127.0.0.1:5442/spectron
APP_URL=http://localhost:5173
API_PORT=3001
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
RESEND_API_KEY=
# A sender on your verified Resend domain.
EMAIL_FROM=Spectron <auth@example.com>

# Optional: cloudflare uses encrypted public DNS when a VPN returns proxy IPs.
# Default is system DNS. Private-network website fetching remains blocked.
PROJECT_LOGO_DNS=system

# File storage: development defaults to <repository>/data/files.
# FILES_ROOT=/absolute/path/to/files
FILES_MAX_BYTES=52428800
# Docker bind mount on the host; provision it writable by FILES_UID/FILES_GID.
FILES_HOST_PATH=./data/files
FILES_UID=1000
FILES_GID=1000
# Docker sets FILE_DELIVERY=nginx; local development defaults to stream.

# Optional dedicated Jira credential encryption secret (32+ characters).
# Defaults to BETTER_AUTH_SECRET. Keep it stable; changing it requires re-entering tokens.
# INTEGRATION_SECRET=

# Yandex Tracker token encryption; generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=
