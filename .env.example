# Local development only. Keep DATABASE_URL in sync with POSTGRES_*.
POSTGRES_PASSWORD=spectron
POSTGRES_PORT=5442
DATABASE_URL=postgresql://spectron:spectron@127.0.0.1:5442/spectron
APP_URL=http://localhost:5173
API_PORT=3001
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
RESEND_API_KEY=
# A sender on your verified Resend domain.
EMAIL_FROM=Spectron <auth@example.com>

# Optional: cloudflare uses encrypted public DNS when a VPN returns proxy IPs.
# Default is system DNS. Private-network website fetching remains blocked.
PROJECT_LOGO_DNS=system

# File storage: development defaults to <repository>/data/files.
# FILES_ROOT=/absolute/path/to/files
FILES_MAX_BYTES=52428800
# Docker bind mount on the host; provision it writable by FILES_UID/FILES_GID.
FILES_HOST_PATH=./data/files
FILES_UID=1000
FILES_GID=1000
# Docker sets FILE_DELIVERY=nginx; local development defaults to stream.

# Optional dedicated Jira/Git credential encryption secret (32+ characters).
# Defaults to BETTER_AUTH_SECRET. Keep it stable; changing it requires re-entering tokens.
# INTEGRATION_SECRET=

# Yandex Tracker token encryption; generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# AI connection encryption. Generate with: openssl rand -base64 32
# Keep stable and backed up; replacing this secret requires re-entering AI keys.
AI_CREDENTIAL_SECRET=

# Git tokens use INTEGRATION_SECRET, falling back to BETTER_AUTH_SECRET. Keep stable.
# Private GitLab instances only: comma-separated HTTPS URLs approved by the server administrator.
# Example: https://gitlab.corp.local/,https://GitLab.other.local:8443
# Entries are normalized to origins; paths are discarded. Invalid entries fail startup.
# TLS certificate verification remains enabled (use NODE_EXTRA_CA_CERTS for an internal CA).
GITLAB_ALLOWED_PRIVATE_ORIGINS=

# Use cloudflare if a VPN substitutes non-public proxy addresses in DNS.
# Explicitly allowed private GitLab origins still use system DNS.
GIT_PROVIDER_DNS=system

# Stage 3: run the API/worker on a host with Docker CLI + daemon and Git.
# Build first: docker build -t spectron-agent:1.18.30 docker/agent-runner
AGENT_RUNNER_ENABLED=false
AGENT_RUNNER_IMAGE=spectron-agent:1.18.30
# Absolute durable path visible at the SAME path to the Docker daemon.
# AGENT_WORKSPACES_ROOT=/absolute/path/to/data/agent-workspaces
AGENT_IDLE_HOURS=3

# Optional verified per-model token limits; snapshot into new agent runs.
# Unlisted models use a conservative 64k context / 8k output until configured.
# AGENT_MODEL_LIMITS_JSON={"zai/glm-5.3-flash":{"context":64000,"output":8192}}
