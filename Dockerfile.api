FROM node:24-alpine
WORKDIR /workspace
RUN npm install --global pnpm@9.15.0
COPY --chown=node:node . .
RUN pnpm install --frozen-lockfile
# The built SPA ships inside this image and is served by the API process, so
# production runs one container instead of an API and an nginx beside it.
RUN pnpm --filter @spectron/app build
# The CLI and its installers, served at /cli/, stamped with the release
# version (release.yml passes it from the vX.Y.Z tag).
ARG SPECTRON_VERSION=0.0.0-dev
RUN SPECTRON_VERSION=$SPECTRON_VERSION pnpm --filter @spectron/cli build
ENV SPECTRON_VERSION=$SPECTRON_VERSION
ENV NODE_ENV=production
ENV API_HOST=0.0.0.0
ENV STATIC_ROOT=/workspace/apps/app/dist
USER node
EXPOSE 3001
CMD ["pnpm", "--filter", "@spectron/api", "start"]
