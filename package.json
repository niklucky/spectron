{
  "name": "spectron",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:app": "pnpm --filter @spectron/app dev",
    "dev:web": "pnpm --filter @spectron/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "compose:up": "docker compose -f compose.local.yml up -d --wait",
    "compose:down": "docker compose -f compose.local.yml down",
    "dev:api": "pnpm --filter @spectron/api dev",
    "db:generate": "pnpm --filter @spectron/db generate",
    "db:migrate": "pnpm --filter @spectron/db migrate",
    "test:auth": "pnpm --filter @spectron/api test",
    "test:projects": "pnpm --filter @spectron/api test:projects",
    "test:issues": "pnpm --filter @spectron/api test:issues",
    "test:files": "pnpm --filter @spectron/api test:files",
    "test:files:nginx": "python3 packages/api/test/nginx-files.py",
    "test:comments": "pnpm --filter @spectron/api test:comments",
    "test:worklogs": "pnpm --filter @spectron/api test:worklogs",
    "test:activity": "pnpm --filter @spectron/api test:activity",
    "test:jira": "pnpm --filter @spectron/api test:jira",
    "test:integrations": "pnpm --filter @spectron/api test:integrations",
    "test:exports": "pnpm --filter @spectron/api test:exports",
    "test:markdown": "pnpm --filter @spectron/api exec tsx --tsconfig ../../apps/app/tsconfig.json --test ../../apps/app/test/message-markdown.test.tsx",
    "test:dates": "pnpm --filter @spectron/api exec node --import tsx --test ../../apps/app/test/date-period.test.ts"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
