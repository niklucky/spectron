    "test:projects": "tsx --test test/projects.test.ts test/project-logo.test.ts test/invitations.test.ts"
  },
  "dependencies": {
    "@spectron/backend": "workspace:*",
    "@spectron/shared": "workspace:*",
    "@spectron/db": "workspace:*",
    "hono": "4.13.7",
    "@hono/node-server": "2.1.1",
    "dotenv": "17.4.2",
    "tsx": "4.23.13",
    "@trpc/server": "11.18.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
