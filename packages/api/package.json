{
  "name": "@spectron/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/trpc/router.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "tsx --test test/auth.test.ts",
    "test:ai": "tsx --test test/ai.test.ts",
    "test:projects": "tsx --test test/projects.test.ts test/project-logo.test.ts test/invitations.test.ts test/id-migration.test.ts",
    "test:issues": "tsx --test test/issues.test.ts test/message-format.test.ts",
    "test:files": "tsx --test test/files.test.ts",
    "test:comments": "tsx --test test/comments.test.ts",
    "test:worklogs": "tsx --test test/worklogs.test.ts",
    "test:activity": "tsx --test test/activity.test.ts",
    "test:jira": "tsx --test test/jira.test.ts",
    "test:integrations": "node --import tsx --test test/tracker.test.ts test/jira.test.ts test/export-sync.test.ts",
    "test:exports": "node --import tsx --test test/export-sync.test.ts",
    "test:git": "tsx --test test/git.test.ts",
    "test:agent-runs": "tsx --test test/agent-runs.test.ts test/agent-runtime.test.ts test/agent-proxy.test.ts test/agent-implementation.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@spectron/backend": "workspace:*",
    "@spectron/db": "workspace:*",
    "@spectron/shared": "workspace:*",
    "@trpc/server": "11.18.0",
    "dotenv": "17.4.2",
    "hono": "4.13.7",
    "tsx": "4.23.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "drizzle-orm": "0.45.2"
  }
}
