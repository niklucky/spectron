# Copy to deployment/.env.production and fill it in. Literal KEY=value, one
# per line, no shell expansion — nothing in this file is ever executed.
#
#   cp deployment/.env.example deployment/.env.production
#   $EDITOR deployment/.env.production
#   ./deployment/provision-app.sh          # the server
#   ./deployment/github-env.sh production  # the GitHub environment
#
# It is read by two scripts and is git-ignored. The top block configures
# provisioning and stays on your machine; everything below it is pushed to the
# GitHub environment by github-env.sh and ends up on the server as the stack's
# .env. Anything left empty is skipped rather than pushed as an empty string,
# so a partially filled file will not wipe what is already configured.

# ── provisioning (local only, never pushed) ──────────────────────────────────

# An SSH alias from your ~/.ssh/config, or user@host.
SSH_TARGET=testron
# Leave empty to honour your SSH config (port, user, identity, ProxyJump).
SSH_PORT=
# Optional identity used for the provisioning connection only.
# SSH_IDENTITY_FILE=/Users/you/.ssh/id_ed25519

# The public half of the deploy key. Its private half goes to GitHub as
# SSH_PRIVATE_KEY (below) and is never uploaded to the server.
DEPLOY_KEY_FILE=deploy_key.pub
# The private half, pushed to GitHub as the SSH_PRIVATE_KEY secret.
SSH_PRIVATE_KEY_PATH=deployment/deploy_key

# Optional. Let's Encrypt discards the contact however you set it, and this
# box already has an ACME account that certbot reuses. Kept for other CAs.
CERT_EMAIL=
# 1 only if www.spectron.dev also points at this server and should be on the
# apex certificate.
INCLUDE_WWW=0

# ── the GitHub environment ───────────────────────────────────────────────────
#
# Secrets (redacted in logs, unreadable afterwards).

# Where the deploy ssh's to. The provision script prints the address it saw.
SSH_HOST=5.181.51.100

# Generate each of these with: openssl rand -base64 32
#
# POSTGRES_PASSWORD is set on the first `compose up` and baked into the
# cluster; changing it later needs an ALTER ROLE on the running database.
POSTGRES_PASSWORD=
# At least 32 characters. Rotating it signs every session out.
BETTER_AUTH_SECRET=
# Optional; defaults to BETTER_AUTH_SECRET. Encrypts stored Jira and Git
# tokens — keep it stable and backed up, or they all have to be re-entered.
INTEGRATION_SECRET=
# Yandex Tracker tokens.
INTEGRATION_ENCRYPTION_KEY=
# Stored AI provider keys. Same warning: stable and backed up.
AI_CREDENTIAL_SECRET=
# Password reset and invitation email. Without both, those flows are disabled
# and the API says so at boot.
RESEND_API_KEY=

# Variables (visible to anyone who can read the repository).

# The public origin of the application. No trailing slash, https in
# production — the API refuses to start otherwise.
APP_URL=https://app.spectron.dev
# A sender on your verified Resend domain.
EMAIL_FROM=Spectron <auth@spectron.dev>
# system, or cloudflare when a VPN substitutes proxy addresses in DNS.
GIT_PROVIDER_DNS=system
PROJECT_LOGO_DNS=system
# Comma-separated HTTPS origins of private GitLab instances to allow.
GITLAB_ALLOWED_PRIVATE_ORIGINS=
# 50 MiB. The API enforces this on the authenticated upload.
FILES_MAX_BYTES=52428800

# Where the stack lives on the box, and the loopback ports it publishes.
# These have to stay clear of testron, which shares the host on 4400/4401.
DEPLOY_PATH=/opt/spectron
APP_PORT=4500
WEB_PORT=4501
DB_PORT=4502
DB_DATA=/data/spectron/db
FILES_DATA=/data/spectron/files
SSH_USER=github
